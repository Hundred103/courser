# Skopiuj do .env (plik .env nie trafia do repozytorium) i ustaw własne wartości.

POSTGRES_DB=courserdb
POSTGRES_USER=courseruser
POSTGRES_PASSWORD=change-me

# Wspólny sekret gatewaya i user-service, co najmniej 32 bajty.
# Wygeneruj np.: openssl rand -base64 48
APP_JWT_SECRET=

# true, gdy aplikacja jest serwowana przez HTTPS (ciasteczko sesji z flagą Secure).
APP_REFRESH_COOKIE_SECURE=false

# Port, pod którym aplikacja jest dostępna w przeglądarce.
FRONTEND_PORT=4200

# Dane przykładowe tylko lokalnie, na świeżej bazie (konto example@email.com / 12345678!).
# Domyślnie: !seed AND !seed-legacy (bez seedów).
# LIQUIBASE_CONTEXTS=seed

